SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
MUNICIPAL_STORAGE_BUCKET=municipal-documents

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_RSeVtSjPNIKnVD"
RAZORPAY_KEY_SECRET="sfUfkapzeI28ayIYFnwvGFvg"


# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@electricity.gov.in

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend URL
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# External Access / Tunneling (Ngrok, Cloudflare Tunnel, etc.)
# Set this to enable QR code scanning from any network (mobile data, different WiFi, etc.)
# When using Ngrok: ngrok http 3000 --> then copy the https URL here
# Example: EXTERNAL_URL=https://abc123.ngrok-free.app
# Leave empty or unset for same-network (LAN) access only
EXTERNAL_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
