# PostgreSQL / Supabase Database URL (for Municipal module)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Configuration (for Municipal file storage)
